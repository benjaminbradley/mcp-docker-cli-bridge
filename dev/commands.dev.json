{
  "default_timeout": 30,
  "commands": {
    "echo_test": {
      "command": ["echo"],
      "allow_extra_args": true,
      "cwd": "/workspace",
      "timeout": 5
    },
    "run_tests": {
      "command": ["python", "-m", "pytest", "tests/", "-v"],
      "allow_extra_args": true,
      "cwd": "/workspace",
      "timeout": 60
    },
    "run_lint": {
      "command": ["python", "-m", "ruff", "check", "server.py"],
      "allow_extra_args": false,
      "cwd": "/workspace"
    },
    "run_typecheck": {
      "command": ["python", "-m", "mypy", "server.py"],
      "allow_extra_args": false,
      "cwd": "/workspace"
    },
    "run_format_check": {
      "command": ["python", "-m", "ruff", "format", "--check", "server.py"],
      "allow_extra_args": false,
      "cwd": "/workspace"
    },
    "run_format": {
      "command": ["python", "-m", "ruff", "format"],
      "allow_extra_args": true,
      "cwd": "/workspace"
    },
    "sleep_test": {
      "command": ["sleep"],
      "allow_extra_args": true,
      "cwd": "/workspace",
      "timeout": 10
    }
  }
}
